# Loaded by Vite ONLY in test mode (vitest). NOT used by the production build
# (that runs in production mode + the verify:prod-clean guard greps the bundle).
# Enables the gated dev-auth button so the SideBand/App tests can exercise the
# dev sign-in path. The dev user id is all-zeros — not a secret.
VITE_ENABLE_DEV_AUTH=1
VITE_DEV_USER_ID=00000000-0000-0000-0000-000000000000
VITE_DEV_USER_NAME=Mantas Misiūnas
VITE_DEV_USER_HANDLE=mantasm
